                cout << "\n=== ОБЩАЯ СТАТИСТИКА ЖЭС ===" << endl;
                if (manager.getResidentCount() == 0) {
                    cout << "Список жильцов пуст! Нет данных для статистики." << endl;
                    break;
                }

                double totalCost = manager.calculateTotalServicesCost();
                cout << "Общая стоимость всех оказанных услуг: "
                    << fixed << setprecision(2) << totalCost << " руб." << endl;
                manager.displayStatistics();
                break;
            }
            case 8: {
                cout << "\n=== ИЗМЕНЕНИЕ ТИПА ЖИЛЬЦА ===" << endl;
                if (manager.getResidentCount() == 0) {
                    cout << "Список жильцов пуст! Не для кого изменять тип льготы." << endl;
                    break;
                }

                string lastName = inputString("Введите фамилию жильца: ", true);
                Resident* resident = manager.findResidentByLastName(lastName);

                if (resident) {
                    cout << "Текущий тип: " << resident->getCostStrategy()->getDescription() << endl;
                    CostCalculationStrategy* newStrategy = selectCostStrategy();
                    resident->setCostStrategy(newStrategy);
                    cout << "Тип жильца успешно изменен!" << endl;
                    cout << "Новый тип: " << resident->getCostStrategy()->getDescription() << endl;
                }
                else {
                    cout << "Жилец не найден!" << endl;
                }
                break;
            }

            case 0: {
                cout << "Выход из программы..." << endl;
                break;
            }
            default: {
                cout << "Неверный выбор меню!" << endl;
                break;
            }
            }
        }
        catch (const exception& e) {
            cerr << "Ошибка: " << e.what() << endl;
        }

    } while (choice != 0);

    cout << "РАБОТА ПРОГРАММЫ ЗАВЕРШЕНА" << endl;
    return 0;
}
